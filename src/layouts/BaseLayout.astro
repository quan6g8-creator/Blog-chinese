---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Học tiếng Trung mỗi ngày' } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body class="page-wrapper">
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="logo flex items-center gap-2">
          <span class="logo-icon">📚</span>
          <span>学中文</span>
        </a>

        <ul class="nav-links">
          <li><a href="/" class="active">Trang chủ</a></li>
          <li><a href="/blog">Bài viết</a></li>
          <li><a href="/blog">Kinh nghiệm</a></li>
          <li><a href="/about">Giới thiệu</a></li>
          <li><a href="/login">Đăng nhập</a></li>
          <li><a href="/register">Đăng ký</a></li>
        </ul>

        <div class="nav-actions">
          <form action="/blog" method="get">
            <input type="text" name="q" placeholder="Tìm bài học, từ vựng..." />
            <button type="submit">Tìm</button>
          </form>
          <a href="tel:+84946979443" class="hotline">
                      📞 0946 979 443
                    </a>
        </div>
      </nav>
    </header>

    <main class="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo">
            <span class="logo-icon">📚</span>
            <span>学中文</span>
          </a>
          <p>Blog học tiếng Trung cho người mới bắt đầu.</p>
        </div>

        <ul class="footer-links">
          <li><a href="/">Trang chủ</a></li>
          <li><a href="/blog">Bài viết</a></li>
          <li><a href="/about">Giới thiệu</a></li>
          <li><a href="/login">Đăng nhập</a></li>
          <li><a href="/register">Đăng ký</a></li>
        </ul>

        <div class="footer-contact">
          <p><strong>Liên hệ</strong></p>
          <p>📞 0375 153 755</p>
          <p>✉️ contact@learnchinese.vn</p>
        </div>
      </div>

      <div class="footer-bottom">
        &copy; 2026 学中文 Blog. Học tiếng Trung mỗi ngày.
      </div>
    </footer>
  </body>
</html>
