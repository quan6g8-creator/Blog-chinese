---
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Blog học tiếng Trung" />
    <title>学中文 - Blog học tiếng Trung</title>
  </head>
  <body>
    <div id="canvas-container"></div>
    
    <header class="site-header-3d">
      <nav class="nav-3d">
        <a href="/" class="logo-3d">📚 学中文</a>
        <ul class="nav-links-3d">
          <li><a href="/">Trang chủ</a></li>
          <li><a href="/blog">Bài viết</a></li>
          <li><a href="/about">Giới thiệu</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <section class="hero-3d">
        <div class="hero-content-3d">
          <h1 class="hero-title-3d">Step into the<br/>living world</h1>
          <p class="hero-subtitle-3d">Blog học tiếng Trung cho người mới bắt đầu</p>
          <a href="/blog" class="hero-cta-3d">Explore the work</a>
        </div>
        <div class="hero-cards-3d">
          <div class="hero-card-3d">
            <div class="hero-card-icon-3d">🌿</div>
            <div class="hero-card-text-3d">Let the wild lead</div>
          </div>
          <div class="hero-card-3d">
            <div class="hero-card-icon-3d">🌧️</div>
            <div class="hero-card-text-3d">After the Rain</div>
          </div>
        </div>
      </section>

      <section class="content-3d">
        <h2 style="margin-bottom:1rem;">Bài viết mới nhất</h2>
        <slot />
      </section>
    </main>

    <footer class="site-footer-3d">
      <p>&copy; 2026 学中文 Blog. Học tiếng Trung mỗi ngày.</p>
    </footer>

  <script>
    import * as THREE from 'three';
    import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
    import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
    import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';

    const container = document.getElementById('canvas-container');
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0a0a12);
    scene.fog = new THREE.FogExp2(0x0a0a12, 0.04);
    
    const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    container?.appendChild(renderer.domElement);

    // Post-processing (bloom/glow)
    const composer = new EffectComposer(renderer);
    composer.addPass(new RenderPass(scene, camera));
    const bloomPass = new UnrealBloomPass(
      new THREE.Vector2(window.innerWidth, window.innerHeight),
      0.6, 0.3, 0.9
    );
    composer.addPass(bloomPass);

    // Lighting
    const ambientLight = new THREE.AmbientLight(0x404060, 0.5);
    scene.add(ambientLight);
    
    const moonLight = new THREE.DirectionalLight(0xffeedd, 0.8);
    moonLight.position.set(5, 10, 5);
    moonLight.castShadow = true;
    scene.add(moonLight);
    
    const pinkLight = new THREE.PointLight(0xff6b9d, 1.5, 20);
    pinkLight.position.set(-3, 3, 2);
    scene.add(pinkLight);
    
    const tealLight = new THREE.PointLight(0x4ecdc4, 1.2, 20);
    tealLight.position.set(4, 2, -2);
    scene.add(tealLight);

    // Terrain with vertex colors (realistic ground)
    const terrainGeometry = new THREE.PlaneGeometry(30, 30, 60, 60);
    const terrainPositions = terrainGeometry.attributes.position.array;
    const terrainColors = new Float32Array(terrainPositions.length);
    
    for (let i = 0; i < terrainPositions.length; i += 3) {
      const x = terrainPositions[i];
      const z = terrainPositions[i + 2];
      const height = Math.sin(x * 0.3) * Math.cos(z * 0.3) * 0.5 + Math.sin(x * 0.1 + z * 0.1) * 0.3;
      terrainPositions[i + 1] = height;
      
      // Color gradient: dark blue to purple
      const t = (height + 1) / 2;
      terrainColors[i] = 0.05 + t * 0.1;
      terrainColors[i + 1] = 0.05 + t * 0.08;
      terrainColors[i + 2] = 0.15 + t * 0.15;
    }
    
    terrainGeometry.setAttribute('color', new THREE.BufferAttribute(terrainColors, 3));
    terrainGeometry.computeVertexNormals();
    
    const terrainMaterial = new THREE.MeshStandardMaterial({
      vertexColors: true,
      roughness: 0.9,
      metalness: 0.1,
      flatShading: false,
    });
    const terrain = new THREE.Mesh(terrainGeometry, terrainMaterial);
    terrain.rotation.x = -Math.PI / 2.3;
    terrain.position.y = -2;
    terrain.receiveShadow = true;
    scene.add(terrain);

    // River/path with water material
    const riverGeometry = new THREE.PlaneGeometry(1.2, 25, 1, 50);
    const riverMaterial = new THREE.MeshStandardMaterial({
      color: 0x1a3a5c,
      roughness: 0.1,
      metalness: 0.8,
      transparent: true,
      opacity: 0.8,
    });
    const river = new THREE.Mesh(riverGeometry, riverMaterial);
    river.rotation.x = -Math.PI / 2.3;
    river.position.y = -1.9;
    river.position.x = 2;
    scene.add(river);

    // Realistic trees
    const treePositions = [
      { x: -5, z: -4 }, { x: -3, z: -6 }, { x: 6, z: -5 },
      { x: 8, z: -3 }, { x: -7, z: -2 }, { x: 4, z: -7 },
      { x: -2, z: -8 }, { x: 7, z: -6 },
    ];
    const trees: THREE.Group[] = [];
    treePositions.forEach((pos) => {
      const tree = new THREE.Group();
      // Trunk
      const trunkGeo = new THREE.CylinderGeometry(0.08, 0.15, 2, 8);
      const trunkMat = new THREE.MeshStandardMaterial({ color: 0x4a3728, roughness: 0.9 });
      const trunk = new THREE.Mesh(trunkGeo, trunkMat);
      trunk.position.y = 1;
      trunk.castShadow = true;
      tree.add(trunk);
      // Foliage (multiple spheres for organic look)
      const foliageMat = new THREE.MeshStandardMaterial({ color: 0x2d5a3d, roughness: 0.8 });
      for (let f = 0; f < 5; f++) {
        const foliageGeo = new THREE.SphereGeometry(0.4 + Math.random() * 0.3, 8, 8);
        const foliage = new THREE.Mesh(foliageGeo, foliageMat);
        foliage.position.set(
          (Math.random() - 0.5) * 0.8,
          2 + Math.random() * 0.8,
          (Math.random() - 0.5) * 0.8
        );
        foliage.castShadow = true;
        tree.add(foliage);
      }
      tree.position.set(pos.x, -2, pos.z);
      scene.add(tree);
      trees.push(tree);
    });

    // Sakura branches (foreground, realistic)
    const sakuraBranches: THREE.Group[] = [];
    for (let b = 0; b < 3; b++) {
      const branch = new THREE.Group();
      // Branch stem (curved)
      const curve = new THREE.CatmullRomCurve3([
        new THREE.Vector3(-2, 0, 0),
        new THREE.Vector3(-0.5, 0.3, 0.1),
        new THREE.Vector3(1, 0.2, -0.1),
        new THREE.Vector3(2, 0.4, 0),
      ]);
      const stemGeo = new THREE.TubeGeometry(curve, 20, 0.03, 8, false);
      const stemMat = new THREE.MeshStandardMaterial({ color: 0x5c3a21, roughness: 0.9 });
      const stem = new THREE.Mesh(stemGeo, stemMat);
      branch.add(stem);
      // Blossoms (clusters of small spheres)
      for (let i = 0; i < 20; i++) {
        const t = Math.random();
        const point = curve.getPoint(t);
        const blossomGeo = new THREE.SphereGeometry(0.06 + Math.random() * 0.04, 6, 6);
        const blossomMat = new THREE.MeshStandardMaterial({ 
          color: new THREE.Color().setHSL(0.93 + Math.random() * 0.04, 0.6, 0.75 + Math.random() * 0.15),
          roughness: 0.6,
        });
        const blossom = new THREE.Mesh(blossomGeo, blossomMat);
        blossom.position.set(
          point.x + (Math.random() - 0.5) * 0.3,
          point.y + (Math.random() - 0.5) * 0.3,
          point.z + (Math.random() - 0.5) * 0.3
        );
        branch.add(blossom);
      }
      branch.position.set(-7 + b * 6, 2.5 + b * 0.3, -4 - b * 0.5);
      branch.rotation.z = (b - 1) * 0.15;
      scene.add(branch);
      sakuraBranches.push(branch);
    }

    // Sakura particles (falling petals)
    const particlesGeometry = new THREE.BufferGeometry();
    const particlesCount = 2000;
    const posArray = new Float32Array(particlesCount * 3);
    const velArray = new Float32Array(particlesCount * 3);
    const rotArray = new Float32Array(particlesCount);
    
    for (let i = 0; i < particlesCount; i++) {
      posArray[i * 3] = (Math.random() - 0.5) * 20;
      posArray[i * 3 + 1] = Math.random() * 15;
      posArray[i * 3 + 2] = (Math.random() - 0.5) * 20;
      velArray[i * 3] = (Math.random() - 0.5) * 0.02;
      velArray[i * 3 + 1] = -Math.random() * 0.03 - 0.01;
      velArray[i * 3 + 2] = (Math.random() - 0.5) * 0.02;
      rotArray[i] = Math.random() * Math.PI * 2;
    }
    
    particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
    
    const particlesMaterial = new THREE.PointsMaterial({
      size: 0.06,
      color: 0xff8fab,
      transparent: true,
      opacity: 0.9,
    });
    
    const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);
    scene.add(particlesMesh);

    // Floating particles (fireflies/sparkles)
    const sparklesGeometry = new THREE.BufferGeometry();
    const sparklesCount = 100;
    const sparklesPos = new Float32Array(sparklesCount * 3);
    for (let i = 0; i < sparklesCount; i++) {
      sparklesPos[i * 3] = (Math.random() - 0.5) * 15;
      sparklesPos[i * 3 + 1] = Math.random() * 8;
      sparklesPos[i * 3 + 2] = (Math.random() - 0.5) * 15;
    }
    sparklesGeometry.setAttribute('position', new THREE.BufferAttribute(sparklesPos, 3));
    const sparklesMat = new THREE.PointsMaterial({
      size: 0.08,
      color: 0xffd700,
      transparent: true,
      opacity: 0.6,
    });
    const sparkles = new THREE.Points(sparklesGeometry, sparklesMat);
    scene.add(sparkles);

    camera.position.z = 7;
    camera.position.y = 1.5;

    // Mouse parallax
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;
    
    document.addEventListener('mousemove', (event) => {
      mouseX = (event.clientX / window.innerWidth) * 2 - 1;
      mouseY = -(event.clientY / window.innerHeight) * 2 + 1;
    });

    // Scroll parallax
    let scrollY = 0;
    window.addEventListener('scroll', () => {
      scrollY = window.scrollY;
    });

    const clock = new THREE.Clock();
    
    function animate() {
      const elapsedTime = clock.getElapsedTime();
      
      targetX += (mouseX * 0.6 - targetX) * 0.02;
      targetY += (mouseY * 0.4 - targetY) * 0.02;
      
      camera.position.x = targetX;
      camera.position.y = 1.5 + targetY - scrollY * 0.0008;
      camera.lookAt(0, 0, 0);
      
      // Animate sakura particles
      const positions = particlesGeometry.attributes.position.array as Float32Array;
      for (let i = 0; i < particlesCount; i++) {
        positions[i * 3] += velArray[i * 3] + Math.sin(elapsedTime * 1.5 + rotArray[i]) * 0.004;
        positions[i * 3 + 1] += velArray[i * 3 + 1];
        positions[i * 3 + 2] += velArray[i * 3 + 2] + Math.cos(elapsedTime * 1.2 + rotArray[i]) * 0.003;
        
        if (positions[i * 3 + 1] < -3) {
          positions[i * 3 + 1] = 12;
          positions[i * 3] = (Math.random() - 0.5) * 20;
          positions[i * 3 + 2] = (Math.random() - 0.5) * 20;
        }
      }
      particlesGeometry.attributes.position.needsUpdate = true;
      
      // Animate sparkles
      const sparklePositions = sparklesGeometry.attributes.position.array as Float32Array;
      for (let i = 0; i < sparklesCount; i++) {
        sparklePositions[i * 3 + 1] += Math.sin(elapsedTime + i) * 0.01;
        sparklePositions[i * 3] += Math.cos(elapsedTime * 0.5 + i) * 0.005;
      }
      sparklesGeometry.attributes.position.needsUpdate = true;
      
      // Animate trees (gentle sway)
      trees.forEach((tree, i) => {
        tree.rotation.z = Math.sin(elapsedTime * 0.4 + i) * 0.02;
      });
      
      // Animate sakura branches
      sakuraBranches.forEach((branch, i) => {
        branch.rotation.z = Math.sin(elapsedTime * 0.3 + i) * 0.03;
      });
      
      // Animate lights
      pinkLight.intensity = 1.5 + Math.sin(elapsedTime * 0.5) * 0.3;
      tealLight.intensity = 1.2 + Math.cos(elapsedTime * 0.4) * 0.2;
      
      terrain.position.z = Math.sin(elapsedTime * 0.08) * 0.3;
      river.position.z = terrain.position.z;
      
      composer.render();
      requestAnimationFrame(animate);
    }
    
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      composer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans SC', sans-serif;
      background: #0a0a0a;
      color: #fff;
      line-height: 1.8;
      overflow-x: hidden;
    }
    
    #canvas-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }
    
    .site-header-3d {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 1.5rem 2rem;
      background: linear-gradient(to bottom, rgba(10,10,10,0.9), transparent);
    }
    
    .nav-3d {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    
    .logo-3d {
      font-size: 1.25rem;
      font-weight: 700;
      color: #fff;
      text-decoration: none;
    }
    
    .nav-links-3d {
      display: flex;
      gap: 2rem;
      list-style: none;
    }
    
    .nav-links-3d a {
      color: rgba(255,255,255,0.7);
      text-decoration: none;
      font-size: 0.95rem;
      transition: color 0.3s;
    }
    
    .nav-links-3d a:hover { color: #fff; }
    
    .hero-3d {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 1200px;
      margin: 0 auto;
      padding: 6rem 2rem 2rem;
      position: relative;
      z-index: 1;
    }
    
    .hero-content-3d {
      flex: 1;
      max-width: 600px;
    }
    
    .hero-title-3d {
      font-size: 4rem;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 1.5rem;
      color: #fff;
      letter-spacing: -0.02em;
    }
    
    .hero-subtitle-3d {
      color: rgba(255,255,255,0.6);
      font-size: 1.15rem;
      margin-bottom: 2rem;
      max-width: 400px;
    }
    
    .hero-cta-3d {
      display: inline-block;
      padding: 0.875rem 2rem;
      background: #fff;
      color: #0a0a0a;
      text-decoration: none;
      border-radius: 50px;
      font-weight: 600;
      font-size: 0.95rem;
      transition: all 0.3s;
    }
    
    .hero-cta-3d:hover {
      background: #ff6b9d;
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(255,107,157,0.3);
    }
    
    .hero-cards-3d {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    
    .hero-card-3d {
      background: rgba(255,255,255,0.05);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 16px;
      padding: 1.5rem;
      min-width: 200px;
      transition: all 0.3s;
    }
    
    .hero-card-3d:hover {
      background: rgba(255,255,255,0.1);
      transform: translateY(-5px);
      border-color: rgba(255,107,157,0.3);
    }
    
    .hero-card-icon-3d {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }
    
    .hero-card-text-3d {
      color: rgba(255,255,255,0.8);
      font-size: 0.9rem;
      font-weight: 500;
    }
    
    .content-3d {
      max-width: 720px;
      margin: 0 auto;
      padding: 4rem 1.5rem;
      position: relative;
      z-index: 1;
    }
    
    .content-3d h2 {
      color: #fff;
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
    }
    
    .content-3d :global(.post-card) {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      backdrop-filter: blur(10px);
    }
    
    .content-3d :global(.post-card h2 a) {
      color: #fff;
    }
    
    .content-3d :global(.post-card h2 a:hover) {
      color: #ff6b9d;
    }
    
    .content-3d :global(.post-meta),
    .content-3d :global(.post-card p) {
      color: rgba(255,255,255,0.6);
    }
    
    .content-3d :global(.tag) {
      background: rgba(255,107,157,0.2);
      color: #ff6b9d;
    }
    
    .site-footer-3d {
      text-align: center;
      padding: 2rem;
      color: rgba(255,255,255,0.4);
      font-size: 0.85rem;
      position: relative;
      z-index: 1;
      border-top: 1px solid rgba(255,255,255,0.05);
    }
    
    @media (max-width: 768px) {
      .hero-3d {
        flex-direction: column;
        justify-content: center;
        text-align: center;
        gap: 2rem;
      }
      
      .hero-title-3d { font-size: 2.5rem; }
      .hero-subtitle-3d { margin: 0 auto 2rem; }
      .hero-cards-3d { flex-direction: row; }
      .hero-card-3d { min-width: 140px; padding: 1rem; }
      .nav-links-3d { display: none; }
    }
  </style>
  </body>
</html>
